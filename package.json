{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version && node scripts/update-version.ts",
    "check": "vp check --fix",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "puppeteer-core": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.3.0",
  "[!start-pkg]": "",
  "name": "monoshot",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Beautiful code images with type-aware twoslash annotations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/monoshot"
  },
  "keywords": [
    "code",
    "image",
    "mcp",
    "screenshot",
    "shiki",
    "twoslash",
    "typescript"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "src": "./src/Headless.ts",
      "types": "./dist/Headless.d.ts",
      "default": "./dist/Headless.js"
    }
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "culori": "catalog:",
    "lz-string": "catalog:",
    "shiki": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "puppeteer-core": "^25.0.0"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": true
    }
  }
}
