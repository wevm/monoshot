{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version && node scripts/update-version.ts",
    "check": "vp check --fix",
    "check:examples": "zile examples:check",
    "check:pack": "node --import tsx scripts/check-packlist.ts",
    "check:skill": "node --import tsx scripts/check-agent-skill.ts",
    "cli": "node --import tsx src/bin.ts",
    "check:types": "tsc",
    "dev": "zile dev",
    "test": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@cloudflare/puppeteer": "1.3.0",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.3.0",
  "[!start-pkg]": "",
  "name": "monoshot",
  "type": "module",
  "version": "0.0.6",
  "license": "MIT",
  "description": "Create code images with syntax highlighting, customizable themes, and type-aware annotations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/monoshot"
  },
  "keywords": [
    "code",
    "image",
    "mcp",
    "screenshot",
    "shiki",
    "twoslash",
    "typescript"
  ],
  "bin": {
    "monoshot": "./dist/bin.js",
    "monoshot.src": "./src/bin.ts"
  },
  "files": [
    "app/public/wallpapers",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "src": "./src/Headless.ts",
      "types": "./dist/Headless.d.ts",
      "default": "./dist/Headless.js"
    }
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@shikijs/transformers": "4.4.2",
    "@shikijs/twoslash": "4.4.2",
    "culori": "catalog:",
    "hono": "catalog:",
    "incur": "catalog:",
    "lz-string": "catalog:",
    "puppeteer-core": "catalog:",
    "shiki": "catalog:",
    "terminal-image": "5.0.1",
    "twoslash": "catalog:",
    "twoslash-cdn": "catalog:",
    "unstorage": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "typescript": "^5.5.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/puppeteer": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
