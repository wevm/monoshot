{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monoshot",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "e6b74cf6ac9241ec99319e6d45fed766"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "SHARE_RATE",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ]
  }
}
